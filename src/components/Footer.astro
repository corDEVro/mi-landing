---
import { socials } from '../data/socials';
import SocialIcon from './icons/SocialIcon.astro';

const year = new Date().getFullYear();
---

<footer class="bg-black text-white/70">
	<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
		<div class="flex flex-col items-center justify-between gap-8 md:flex-row md:items-start">
			<div class="text-center md:text-left">
				<span class="inline-block rounded-lg bg-mint px-3 py-2">
					<img src="/Logo.png" alt="CORDEVRO" class="h-8 w-auto" />
				</span>
				<p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed md:mx-0">
					Soluciones digitales a medida para hacer crecer tu negocio.
				</p>
			</div>

			<ul class="flex items-center gap-4">
				{socials.map((social) => (
					<li>
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={social.label}
							class="text-white/70 transition hover:text-mint"
						>
							<SocialIcon icon={social.icon} />
						</a>
					</li>
				))}
			</ul>
		</div>

		<div class="mt-10 border-t border-white/10 pt-6 text-center text-sm">
			<p>© {year} CORDEVRO. Todos los derechos reservados.</p>
		</div>
	</div>
</footer>
